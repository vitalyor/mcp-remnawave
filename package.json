{
  "name": "remnawave-mcp",
  "version": "3.4.8",
  "description": "MCP server for Remnawave proxy management panel",
  "type": "module",
  "bin": {
    "remnawave-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "check": "tsc -p . && tsup && node dist/check.js"
  },
  "keywords": [
    "mcp",
    "remnawave",
    "vpn",
    "proxy",
    "xray"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
