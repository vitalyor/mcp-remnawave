REMNAWAVE_BASE_URL=https://vpn.example.com
REMNAWAVE_API_TOKEN=your-api-token-here

# Optional: API key for Caddy reverse proxy with custom path
# See: https://docs.remnawave.com/docs/security/caddy-with-custom-path/
# REMNAWAVE_API_KEY=your-caddy-api-key

# Optional: access mode (default: full)
#   readonly - read/list tools only (78 tools)
#   safe     - no destructive operations (126 tools)
#   full     - everything (171 tools)
# REMNAWAVE_MODE=safe

# Tools listed directly (comma-separated) or "all"; default is the core set,
# everything else is reached via search_api / call_api.
# REMNAWAVE_TOOLS=all
# REMNAWAVE_MAX_RESPONSE_CHARS=40000
# REMNAWAVE_TIMEOUT_MS=30000
